{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // packages/pixel-service is plain .mjs with JSDoc types and is imported by
    // path rather than as a workspace dependency, so summarise() is read from
    // the same file the deployed service runs.
    "allowJs": true
  },
  "include": ["./**/*.ts", "./**/*.cts", "../shared/**/*.ts"]
}
